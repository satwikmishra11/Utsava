# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development
PORT=3000

# Default LLM Provider ('claude' | 'gemini' | 'mock')
LLM_PROVIDER=mock

# Anthropic Claude API Key (Required when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (Required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
