# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development
PORT=3000

# Default LLM Provider ('auto' | 'gemini' | 'claude' | 'mock')
LLM_PROVIDER=auto

# Model Overrides
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_MODEL=claude-sonnet-5-5

# Set to true to allow MockProvider in production mode
ALLOW_DEMO_MODE=false

# Anthropic Claude API Key (Required when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (Required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Session Secret (Must be at least 32 characters for HMAC-SHA256 cookie signing; required in production)
SESSION_SECRET=replace_with_a_secure_random_32_character_secret_for_production
